{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "https://misitioproduccion.com" ]
  },
  "RateLimiting": {
    "LoginLimit": 5,
    "GlobalLimit": 100
  },
  "Facturacion": {
    "Workers": {
      "Enabled": true
    },
    "Storage": {
      "BasePath": "App_Data/Facturacion"
    }
  }
}
